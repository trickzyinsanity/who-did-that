{
  "name": "who-did-that",
  "version": "1.0.0",
  "private": true,
  "description": "Party game: everyone writes one anecdote, then the group votes on who wrote each one.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "online": "node server.js --online --open",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
